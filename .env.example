# Discord Developer Portal token (never commit a real value)
DISCORD_TOKEN=
# SQLite: sqlite:///data/bot.db or sqlite:////absolute/path/bot.db
DATABASE_URL=sqlite:///data/bot.db
# Comma-separated numeric Discord user IDs
OWNER_IDS=
DEFAULT_PREFIX=!
LOG_LEVEL=INFO
BOT_NAME=Aegis
BOT_VERSION=1.0.0
# Optional integrations
OPENWEATHER_API_KEY=
# Optional self-hosted LibreTranslate-compatible endpoint
TRANSLATE_API_URL=
# Copy commands to a development guild immediately instead of global sync
SYNC_GUILD_ID=
